# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored and must never be committed.

# NewsAPI key — https://newsapi.org
NEWSAPI_KEY=

# Which LLM backend to use: groq | azure
LLM_PROVIDER=groq

# Groq API key — https://console.groq.com
GROQ_API_KEY=

# Azure OpenAI — https://portal.azure.com
# AZURE_OPENAI_DEPLOYMENT is your deployment name, not the model name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# AZURE_OPENAI_API_VERSION=2024-10-21
# NEWS_LANGUAGE=en
# NEWS_COUNTRY=          (e.g. us; empty = any country)
# LOG_LEVEL=INFO
# LOG_FILE=logs/solon.log   (relative to backend/; empty disables file logging)
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
# BATCH_MAX_TOKENS=100000
# BATCH_MAX_CONCURRENCY=4
# MIN_CONTENT_CHARS=600
# DATABASE_URL=            (default: SQLite at backend/data/solon.db;
#                           e.g. postgresql+asyncpg://user:pass@host/solon)
# PROFILE_PATH=profiles/default.json

# LLM prices per 1M tokens, used to estimate the cost of each LLM operation
# (leave unset to show token counts only). Use your provider's pricing page.
# GROQ_PRICE_INPUT_PER_1M=0.15
# GROQ_PRICE_OUTPUT_PER_1M=0.60
# AZURE_PRICE_INPUT_PER_1M=0.40
# AZURE_PRICE_OUTPUT_PER_1M=1.60
# LLM_PRICE_CURRENCY=USD
