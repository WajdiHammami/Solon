/*
 * Solon theme — Catppuccin Mocha.
 *   crust #11111b  mantle #181825  base #1e1e2e
 *   surface0 #313244  surface1 #45475a  surface2 #585b70
 *   overlay0 #6c7086  overlay1 #7f849c  subtext0 #a6adc8  text #cdd6f4
 *   blue #89b4fa  lavender #b4befe  sapphire #74c7ec  green #a6e3a1
 *   yellow #f9e2af  red #f38ba8
 */

QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: "Inter", "Segoe UI", "Ubuntu Sans", "Ubuntu", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog {
    background-color: #1e1e2e;
}

QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
}

/* --- Inputs ------------------------------------------------------------- */

QLineEdit, QSpinBox, QComboBox {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 7px 12px;
    color: #cdd6f4;
    selection-background-color: #45475a;
}

QLineEdit#searchBar {
    padding: 9px 14px;
    font-size: 15px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #89b4fa;
}

QComboBox {
    padding: 5px 12px;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    selection-background-color: #313244;
    outline: none;
    padding: 4px;
}

QCheckBox {
    spacing: 8px;
    color: #a6adc8;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #6c7086;
    border-radius: 4px;
    background-color: transparent;
}

QCheckBox::indicator:checked {
    background-color: #89b4fa;
    border-color: #89b4fa;
}

QCheckBox::indicator:indeterminate {
    background-color: rgba(137, 180, 250, 0.45);
    border-color: #89b4fa;
}

/* --- Buttons ------------------------------------------------------------ */

QPushButton {
    background-color: #89b4fa;
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: bold;
}

QPushButton:hover   { background-color: #b4befe; }
QPushButton:pressed { background-color: #74c7ec; }

QPushButton:disabled {
    background-color: #313244;
    color: #6c7086;
}

QPushButton#secondaryButton {
    background-color: transparent;
    color: #89b4fa;
    border: 1px solid #45475a;
}

QPushButton#secondaryButton:hover {
    background-color: #313244;
    border-color: #89b4fa;
}

QPushButton#secondaryButton:disabled {
    color: #6c7086;
    border-color: #313244;
}

/* --- Panels ------------------------------------------------------------- */

QListView#articleList {
    background-color: #181825;
    border: none;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QLabel#emptyHint {
    background-color: #181825;
    border-radius: 10px;
    color: #7f849c;
    font-size: 13px;
}

QLabel#mutedLabel {
    color: #7f849c;
    font-size: 13px;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:hover {
    background-color: #313244;
}

/* --- Detail panel --------------------------------------------------------- */

QWidget#detailPanel, QWidget#detailContent, QScrollArea#detailScroll {
    background-color: #181825;
    border-radius: 10px;
}

QLabel#detailTitle {
    font-size: 21px;
    font-weight: bold;
    color: #cdd6f4;
    background: transparent;
}

QLabel#sourcePill {
    background-color: #313244;
    color: #89b4fa;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: bold;
}

QLabel#detailDate, QLabel#detailLink {
    color: #7f849c;
    font-size: 12px;
    background: transparent;
}

QLabel#biasChip {
    border-radius: 10px;
    padding: 3px 12px;
    font-size: 12px;
    font-weight: bold;
}

QLabel#biasExplanation {
    background-color: #1e1e2e;
    color: #a6adc8;
    font-size: 13px;
    font-style: italic;
    padding: 10px 12px;
    border-radius: 6px;
}

QLabel#sectionHeading, QLabel#synthesisHeader {
    color: #7f849c;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QLabel#detailSummary {
    font-size: 15px;
    color: #cdd6f4;
    background: transparent;
}

/* --- Synthesis ------------------------------------------------------------ */

QTextEdit#synthesisText {
    background-color: #181825;
    border: none;
    border-radius: 10px;
    color: #cdd6f4;
    font-size: 14px;
}

QLabel#synthesisNotice {
    background-color: rgba(249, 226, 175, 0.08);
    border: 1px solid rgba(249, 226, 175, 0.35);
    color: #f9e2af;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

/* --- Reader --------------------------------------------------------------- */

QTextBrowser#readerText {
    background-color: #1e1e2e;
    border: none;
    font-family: "Georgia", "Noto Serif", "DejaVu Serif", serif;
}

/* --- Settings dialog -------------------------------------------------------- */

QLabel#settingsHeader {
    font-size: 16px;
    font-weight: bold;
    color: #89b4fa;
}

QLabel#settingsHint {
    color: #7f849c;
    font-size: 12px;
}

QLabel#settingsError {
    color: #f38ba8;
    font-weight: bold;
}

/* --- Chrome --------------------------------------------------------------- */

QToolBar {
    background-color: #181825;
    border: none;
    padding: 8px 6px;
    spacing: 6px;
}

QToolBar QToolButton {
    padding: 7px;
    border-radius: 8px;
}

QToolBar QToolButton:hover {
    background-color: #313244;
}

QStatusBar {
    background-color: #181825;
    color: #7f849c;
    font-size: 12px;
    padding-left: 8px;
}

QStatusBar::item { border: none; }

QStatusBar[severity="success"] { color: #a6e3a1; }
QStatusBar[severity="warning"] { color: #f9e2af; }
QStatusBar[severity="error"]   { color: #f38ba8; font-weight: bold; }

QProgressBar {
    background-color: #313244;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-width: 140px;
}

QProgressBar::chunk {
    background-color: #89b4fa;
    border-radius: 3px;
}

/* Thin, quiet scrollbars. */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #45475a;
    border-radius: 3px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover { background: #585b70; }

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #45475a;
    border-radius: 3px;
    min-width: 32px;
}

QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
